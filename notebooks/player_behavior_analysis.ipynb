SECTORS = ['virtual', 'other', 'tv']
CHANNELS = ['organic','paid_search','paid_social','affiliate']

# 1) Дані: читаємо CSV або генеруємо синтетику
DATA_PATH = Path("data/transactions.csv")

if DATA_PATH.exists():
    df = pd.read_csv(DATA_PATH)
    df['date'] = pd.to_datetime(df['date'])
    print("✅ Loaded source data:", len(df))
else:
    start_date = pd.Timestamp('2024-09-01')
    dates_all = pd.date_range(start_date, periods=30, freq='D')
    users = np.arange(10_000, 10_200)
    rng = np.random.default_rng(42)
    rows = []
    for u in users:
        ch = rng.choice(CHANNELS, p=[0.35,0.25,0.25,0.15])
        active_days = rng.choice(dates_all, size=rng.integers(6,18), replace=False)
        for d in active_days:
            for s in SECTORS:
                engage = (s=='virtual') or (rng.random() < 0.45)
                if not engage: 
                    continue
                spend = float(rng.gamma(shape=2.0, scale=5.0))
                if rng.random() < 0.25:
                    spend = 0.0
                rows.append({
                    'user_id': u,
                    'date': pd.Timestamp(d),
                    'spend': round(spend, 2),
                    'sector': s,
                    'acquisition_channel': ch
                })
    df = pd.DataFrame(rows)
    print("ℹ️ Using synthetic data:", len(df))

# 2) Препроцесинг
df['sector'] = df['sector'].str.lower().str.strip()
df = df.groupby(['user_id','date','sector','acquisition_channel'], as_index=False)['spend'].sum()
period_start = df['date'].min().normalize()
dates = pd.date_range(period_start, periods=30, freq='D')

# 3) Повна щоденна сітка (user × date × sector) + long
def make_full_grid(df):
    users = df['user_id'].unique()
    out = []
    for u in users:
        u_df = df[df['user_id']==u]
        ch = u_df['acquisition_channel'].mode().iloc[0]
        pivot = u_df.pivot_table(index='date', columns='sector', values='spend', aggfunc='sum', fill_value=0.0)
        for s in SECTORS:
            if s not in pivot.columns:
                pivot[s] = 0.0
        pivot = pivot.reindex(dates, fill_value=0.0).reset_index()  # 'date' вже є після reset_index
        pivot['user_id'] = u
        pivot['acquisition_channel'] = ch
        out.append(pivot[['user_id','date','acquisition_channel', *SECTORS]])
    grid = pd.concat(out, ignore_index=True)
    long = grid.melt(id_vars=['user_id','date','acquisition_channel'],
                     value_vars=SECTORS, var_name='sector', value_name='spend')
    return grid, long

full_wide, full_long = make_full_grid(df)
print("grid-wide:", full_wide.shape, "| grid-long:", full_long.shape)

# 4) Щоденні метрики користувача: активність, gap_days, churn_flag
daily = (full_long.groupby(['user_id','date'], as_index=False)
         .agg(total_spend=('spend','sum')))
daily['is_active'] = (daily['total_spend']>0).astype(int)
daily = daily.sort_values(['user_id','date'])
daily['prev_date'] = daily.groupby('user_id')['date'].shift(1)
daily['gap_days'] = (daily['date'] - daily['prev_date']).dt.days
daily['gap_days'] = daily['gap_days'].fillna(0)
daily['prev_active'] = daily.groupby('user_id')['is_active'].shift(1).fillna(0)
daily['churn_flag'] = ((daily['gap_days']>7) & (daily['prev_active']==1)).astype(int)

# 5) Фічі: лаги/ролінги по секторах + крос-співвідношення
feat = full_wide.copy().sort_values(['user_id','date'])
for s in SECTORS:
    feat[f'{s}_lag1']  = feat.groupby('user_id')[s].shift(1).fillna(0)
    feat[f'{s}_lag7']  = feat.groupby('user_id')[s].shift(7).fillna(0)
    feat[f'{s}_roll3'] = feat.groupby('user_id')[s].rolling(3, min_periods=1).sum().reset_index(level=0, drop=True)
    feat[f'{s}_roll7'] = feat.groupby('user_id')[s].rolling(7, min_periods=1).sum().reset_index(level=0, drop=True)

eps = 1e-9
feat['virtual_other_ratio'] = feat['virtual']/(feat['other']+eps)
feat['virtual_tv_ratio']    = feat['virtual']/(feat['tv']+eps)
feat['other_tv_ratio']      = feat['other']/(feat['tv']+eps)

feature_daily = feat.merge(
    daily[['user_id','date','gap_days','churn_flag','is_active']],
    on=['user_id','date'], how='left'
)

# 6) Матриці переходів (рахуємо переходи навіть після пауз — 'pause')
def transition_matrix(grid_long: pd.DataFrame, weighted: bool=False) -> pd.DataFrame:
    records = []
    for uid, g in grid_long.groupby('user_id'):
        d = (g.pivot_table(index='date', columns='sector', values='spend', fill_value=0.0)
               .reindex(dates, fill_value=0.0))
        total = d[SECTORS].sum(axis=1)
        state = np.where(total==0, 'pause', d[SECTORS].idxmax(axis=1))
        weight = total
        s = pd.DataFrame({'state': state, 'weight': weight}).reset_index(drop=True)
        for i in range(len(s)-1):
            w = float(s.loc[i+1,'weight']) if weighted else 1.0
            records.append((s.loc[i,'state'], s.loc[i+1,'state'], w))
    if not records:
        return pd.DataFrame()
    dfm = pd.DataFrame(records, columns=['from','to','value'])
    mat = dfm.pivot_table(index='from', columns='to', values='value', aggfunc='sum', fill_value=0.0)
    states = SECTORS + ['pause']
    return mat.reindex(index=states, columns=states, fill_value=0.0)

trans_counts   = transition_matrix(full_long, weighted=False)
trans_weighted = transition_matrix(full_long, weighted=True)

fig, axes = plt.subplots(1,2, figsize=(14,5))
sns.heatmap(trans_counts,   annot=True, fmt='.0f', cmap='Blues',   ax=axes[0]); axes[0].set_title('Transitions – counts')
sns.heatmap(trans_weighted, annot=True, fmt='.1f', cmap='Purples', ax=axes[1]); axes[1].set_title('Transitions – weighted (by next-day total)')
plt.tight_layout(); plt.show()

# 7) Динаміка витрат: 7-денні середні по секторах
roll = (full_long.groupby(['date','sector'])['spend'].sum().reset_index())
roll['roll7'] = roll.groupby('sector')['spend'].transform(lambda s: s.rolling(7, min_periods=1).mean())
plt.figure(figsize=(10,4))
for s in SECTORS:
    r = roll[roll['sector']==s]
    plt.plot(r['date'], r['roll7'], label=f'{s} 7d mean')
plt.title('7-day rolling spend by sector'); plt.legend(); plt.tight_layout(); plt.show()

# 8) Кластеризація користувачів (baseline)
user_features = (feature_daily.groupby('user_id')
                 .agg(days_active=('is_active','sum'),
                      zero_share=('is_active', lambda x: 1.0 - float(x.mean())),
                      monetary_virtual=('virtual','mean'),
                      monetary_other=('other','mean'),
                      monetary_tv=('tv','mean'),
                      total_spend=('virtual','sum'))
                 .reset_index())

Xc = user_features.drop(columns=['user_id']).fillna(0)
scaled = StandardScaler().fit_transform(Xc)
sil_scores = {}
for k in range(2, 7):
    km = KMeans(n_clusters=k, random_state=42, n_init='auto')
    sil_scores[k] = silhouette_score(scaled, km.fit_predict(scaled))
best_k = max(sil_scores, key=sil_scores.get)
kmeans = KMeans(n_clusters=best_k, random_state=42, n_init='auto').fit(scaled)
user_features['cluster'] = kmeans.labels_

pca = PCA(n_components=2).fit_transform(scaled)
plt.figure(figsize=(8,6))
sns.scatterplot(x=pca[:,0], y=pca[:,1], hue=user_features['cluster'], palette='viridis', s=35)
plt.title(f'User clusters (PCA, k={best_k})'); plt.xlabel('pc1'); plt.ylabel('pc2'); plt.tight_layout(); plt.show()

# 9) Ентропія розподілу витрат по секторах (надійно, без дублю user_id)
sector_share = (
    full_long.groupby(['user_id', 'sector'])['spend']
    .sum()
    .groupby(level=0)  # рівень 0 = user_id
    .apply(lambda s: s / (s.sum() + 1e-9))
)

# привели до DataFrame з чіткими стовпцями
if isinstance(sector_share, pd.Series):
    sector_share = sector_share.rename('share').reset_index()
else:
    sector_share = sector_share.to_frame(name='share').reset_index()

entropy_df = (
    sector_share.groupby('user_id')['share']
    .apply(lambda v: float(-(v * np.log2(v + 1e-12)).sum()))
    .reset_index(name='entropy_sector')
)

user_features = user_features.merge(entropy_df, on='user_id', how='left')
display(user_features.head())
