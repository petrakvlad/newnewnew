def channel_transition_matrices(df_long):
    mats={}
    for ch, g in df_long.groupby('acquisition_channel'):
        m = transition_matrix(g, weighted=False)
        if not m.empty: mats[ch]=m
    return mats

mats = channel_transition_matrices(full_long)
for ch, mat in mats.items():
    plt.figure(figsize=(4.8,4))
    sns.heatmap(mat, annot=True, fmt='.0f', cmap='Blues')
    plt.title(f'Transitions (counts) – {ch}'); plt.tight_layout(); plt.show()

# 18) Аномалії user-day (IsolationForest)
user_day = full_long.groupby(['user_id','date'], as_index=False)['spend'].sum()
iso = IsolationForest(contamination=0.02, random_state=42)
user_day['anomaly'] = iso.fit_predict(user_day[['spend']])  # -1 = аномалія
anom = user_day[user_day['anomaly']==-1]
print("Anomalous rows:", len(anom))
plt.figure(figsize=(9,3.6))
sns.scatterplot(data=user_day, x='date', y='spend', alpha=0.4, s=12, color='gray')
sns.scatterplot(data=anom, x='date', y='spend', color='red', s=22, label='anomaly')
plt.title('User-day spend anomalies'); plt.tight_layout(); plt.show()

# 19) Короткі інсайти (авто)
def quick_insights():
    # топ-перехід
    tc = trans_counts.stack().sort_values(ascending=False)
    top_transition = tc.index[0] if len(tc)>0 else ('n/a','n/a')
    # канал з найбільшим avg_user_spend
    top_channel = ltv.sort_values('avg_user_spend', ascending=False).head(1)
    top_channel = (top_channel['acquisition_channel'].iloc[0], float(top_channel['avg_user_spend'].iloc[0])) if len(top_channel)>0 else ('n/a',0.0)
    print(f"• Most frequent transition: {top_transition[0]} → {top_transition[1]}")
    print(f"• Highest avg user spend channel: {top_channel[0]} (~{top_channel[1]:.2f})")
    print(f"• Anomalous user-days detected: {len(anom)}")

quick_insights()

print("\n✅ All three parts executed successfully.")
