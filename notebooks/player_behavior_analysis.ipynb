# 13) Cross-sector activation: вірогідність активуватись в other/tv
from sklearn.metrics import average_precision_score

def train_cross_sector_activation(df: pd.DataFrame):
    X = df.drop(columns=['user_id','date','next_date','next_sector','next_spend']).copy()
    X['activate_other_tv'] = (df[['next_other','next_tv']].sum(axis=1)>0).astype(int)
    y = X.pop('activate_other_tv')
    for col in X.select_dtypes(include=['object','category']).columns:
        X[col] = X[col].astype('category').cat.codes
    tscv = TimeSeriesSplit(n_splits=3)
    for fold,(tr,te) in enumerate(tscv.split(X),1):
        Xtr,Xte = X.iloc[tr],X.iloc[te]
        ytr,yte = y.iloc[tr],y.iloc[te]
        if LGBM_AVAILABLE:
            dtr = lgb.Dataset(Xtr, label=ytr); dte = lgb.Dataset(Xte, label=yte, reference=dtr)
            params = {'objective':'binary','learning_rate':0.05,'num_leaves':31,
                      'metric':['auc','binary_logloss'],'verbose':-1}
            model = lgb.train(params, dtr, valid_sets=[dte], num_boost_round=300,
                              callbacks=[lgb.early_stopping(30), lgb.log_evaluation(20)])
            prob = model.predict(Xte)
        else:
            from sklearn.ensemble import RandomForestClassifier
            rf = RandomForestClassifier(n_estimators=300, random_state=42, class_weight='balanced')
            model = rf.fit(Xtr,ytr); prob = rf.predict_proba(Xte)[:,1]
        roc = roc_auc_score(yte, prob)
        pr  = average_precision_score(yte, prob)
        print(f'Fold {fold}: ROC-AUC={roc:.3f}, PR-AUC={pr:.3f}')
    return model

act_model = train_cross_sector_activation(model_df)
