# 16) DTW: кластеризація форм послідовностей (dominant state per day)
try:
    from tslearn.metrics import cdist_dtw
    from sklearn.manifold import MDS

    token_map = {'pause':0, 'virtual':1, 'other':2, 'tv':3}
    seq_rows = []
    for uid, g in full_wide.groupby('user_id'):
        g = g.sort_values('date')
        total = g[SECTORS].sum(axis=1)
        state = np.where(total==0, 'pause', g[SECTORS].idxmax(axis=1))
        seq_rows.append((uid, [token_map[s] for s in state]))
    max_users = min(400, len(seq_rows))
    seq_rows = seq_rows[:max_users]
    seq_mat = np.array([np.array(s, dtype=float).reshape(-1,1) for _, s in seq_rows])
    dists = cdist_dtw(seq_mat)
    emb = MDS(n_components=2, dissimilarity='precomputed', random_state=42).fit_transform(dists)
    km_dtw = KMeans(n_clusters=4, random_state=42, n_init='auto').fit(emb)
    labels_dtw = km_dtw.labels_
    plt.figure(figsize=(8,6))
    sns.scatterplot(x=emb[:,0], y=emb[:,1], hue=labels_dtw, palette='tab10', s=35)
    plt.title('DTW-based clusters of behavior sequences'); plt.xlabel('dim-1'); plt.ylabel('dim-2')
    plt.tight_layout(); plt.show()

    # Профілі кластера
    def state_share(seq):
        vals, counts = np.unique(seq, return_counts=True)
        return {int(v): float(c)/len(seq) for v,c in zip(vals,counts)}
    inv = {v:k for k,v in token_map.items()}
    profiles = []
    for k in range(labels_dtw.max()+1):
        seqs_k = [seq_rows[i][1] for i in range(len(seq_rows)) if labels_dtw[i]==k]
        shares = pd.DataFrame([state_share(s) for s in seqs_k]).fillna(0).mean().to_dict()
        shares_named = {inv[int(code)]: float(val) for code,val in shares.items()}
        profiles.append({'cluster_dtw': k, **shares_named})
    display(pd.DataFrame(profiles).fillna(0))
except Exception as e:
    print("DTW недоступний або помилка:", e)

