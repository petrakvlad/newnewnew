# 11) Класифікація: прогноз сектору наступного дня з візуалізаціями
def train_next_sector_classifier(df: pd.DataFrame):
    # features & target
    X = df.drop(columns=['user_id','date','next_date','next_spend','next_sector'], errors='ignore').copy()
    y = df['next_sector'].astype(str)
    # ensure numeric
    for col in X.select_dtypes(include=['object','category']).columns:
        X[col] = X[col].astype('category').cat.codes
    # encode target
    y_codes, y_uniques = pd.factorize(y)
    tscv = TimeSeriesSplit(n_splits=3)
    reports = []
    for fold,(tr,te) in enumerate(tscv.split(X),1):
        Xtr,Xte = X.iloc[tr],X.iloc[te]
        ytr,yte = y_codes[tr], y_codes[te]
        if LGBM_AVAILABLE:
            dtr = lgb.Dataset(Xtr, label=ytr)
            dte = lgb.Dataset(Xte, label=yte, reference=dtr)
            params = {'objective':'multiclass','num_class':len(y_uniques),'learning_rate':0.05,
                      'metric':'multi_logloss','num_leaves':31,'verbose':-1}
            model = lgb.train(params, dtr, valid_sets=[dte], num_boost_round=400,
                              callbacks=[lgb.early_stopping(40), lgb.log_evaluation(50)])
            preds = np.argmax(model.predict(Xte), axis=1)
        else:
            rf = RandomForestClassifier(n_estimators=300, random_state=42)
            model = rf.fit(Xtr,ytr); preds = model.predict(Xte)
        acc = np.mean(preds == yte)
        print(f'Fold {fold}: accuracy={acc:.3f}')
        # Confusion matrix
        cm = confusion_matrix(yte, preds, labels=np.arange(len(y_uniques)))
        plt.figure(figsize=(6,5))
        sns.heatmap(cm/cm.sum(axis=1, keepdims=True), annot=True, fmt='.2f', cmap='Blues',
                    xticklabels=y_uniques, yticklabels=y_uniques)
        plt.title(f'Confusion Matrix – fold {fold}'); plt.xlabel('Pred'); plt.ylabel('True')
        plt.tight_layout(); plt.show()
        # Report
        print(classification_report(yte, preds, target_names=list(y_uniques), zero_division=0))
        reports.append((model, acc))
    best_model = reports[-1][0]
    return best_model, list(y_uniques), X.columns.tolist()

clf_model, sector_labels, clf_features = train_next_sector_classifier(model_df)

# 12) Регресія: прогноз суми витрат наступного дня (MAE/RMSE + графіки)
def train_next_spend_regressor(df: pd.DataFrame):
    X = df.drop(columns=['user_id','date','next_date','next_sector','next_spend'], errors='ignore').copy()
    y = df['next_spend'].astype(float)
    for col in X.select_dtypes(include=['object','category']).columns:
        X[col] = X[col].astype('category').cat.codes
    tscv = TimeSeriesSplit(n_splits=3)
    metrics = []
    for fold,(tr,te) in enumerate(tscv.split(X),1):
        Xtr,Xte = X.iloc[tr],X.iloc[te]
        ytr,yte = y.iloc[tr],y.iloc[te]
        if LGBM_AVAILABLE:
            dtr = lgb.Dataset(Xtr, label=ytr); dte = lgb.Dataset(Xte, label=yte, reference=dtr)
            params = {'objective':'regression','learning_rate':0.05,'num_leaves':31,
                      'feature_fraction':0.9,'metric':'l2','verbose':-1}
            model = lgb.train(params, dtr, valid_sets=[dte], num_boost_round=400,
                              callbacks=[lgb.early_stopping(40), lgb.log_evaluation(20)])
            preds = model.predict(Xte)
        else:
            rf = RandomForestRegressor(n_estimators=400, random_state=42)
            model = rf.fit(Xtr,ytr); preds = model.predict(Xte)
        mae = mean_absolute_error(yte, preds)
        rmse = np.sqrt(mean_squared_error(yte, preds))
        metrics.append({'fold':fold,'MAE':mae,'RMSE':rmse})
        print(f'Fold {fold}: MAE={mae:.3f}, RMSE={rmse:.3f}')
        plt.figure(figsize=(5,4))
        sns.scatterplot(x=yte, y=preds, s=18, alpha=0.6)
        lims = [min(yte.min(), preds.min()), max(yte.max(), preds.max())]
        plt.plot(lims, lims, 'r--'); plt.xlabel('True'); plt.ylabel('Pred'); plt.title(f'Reg – fold {fold}')
        plt.tight_layout(); plt.show()
    return model, pd.DataFrame(metrics)

reg_model, reg_metrics = train_next_spend_regressor(model_df)
